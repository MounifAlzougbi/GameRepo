function is_dead(level)
	local dead=0
	for x=1,128 do
		if pget(x,level)==0 then
			dead+=1
		end
	end
	
	if dead>127 then
		return true
	else
		return false end end


function init_state(int)
	for i=1,int do
		local rand=flr(rnd(128))
		pset(rand,0,2)
	end
end

function shift_up()
		
	for y=2,127 do
		local ytbl={}
		for x=1,128 do
			add(ytbl,pget(x,y))
		end
		
		for x=1,128 do
			pset(x,y-1,ytbl[x])
		end
		
	end
	
end
-->8

function automata_init()
		
	rule_mem=8000 

	rule=184 -- any int 1-256
	
	rands=50 -- starting points
	
	init_state(rands)
	
	y=0

	
end

-- rets new layer from y
function new_layer(y)
	
	for x=0,127 do
		if x==1 then
			left=pget(128,y)
			right=pget(x+1,y)
		elseif x==128 then
			left=pget(x-1,y)
			right=pget(1,y)
		else
			left=pget(x-1,y)
			right=pget(x+1,y)
		end
		
		local center=pget(x,y)
		
		local bstr=left<<2|center<<1|right
		
		next_val=(rule>>bstr)&1
		
		pset(x,y+1,next_val)
		
	end
	
end

total=0

function automata_update()
	
	last_t=last_t or 0
	t=time()
	delta_t=t-last_t
	
	total+=delta_t
	
	if total>0.05 then
		new_layer(y)
		y+=1
		total=0
	end
	
	if y>127 or is_dead(y) 
		or btn(❎) then
		local rand=flr(rnd(255))
		rule=rand
		y=0
--		shift_up
--		if rule<255 then
--			rule+=1
--		else
--			rule=1
--		end
		cls()
		init_state(rands)
	end
	
	last_t=time()
	
end
