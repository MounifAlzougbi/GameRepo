pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include mouse.lua
#include electron.lua

-- @init
function _init()
	local lastTime,deltaTime
	electronInit()
end

-- @update
function _update()
	local currentTime=time()

	if lastTime!=nil then
		deltaTime=currentTime-lastTime
	else deltaTime=0 end

	electronUpdate(deltaTime)

	lastTime=time()
end

-- @draw
function _draw()
	cls()
	electronDraw()
end

__gfx__
