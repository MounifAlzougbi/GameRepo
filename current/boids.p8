pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

#include boids.lua

startTime,endTime,deltaTime=0,0,0

function _init()
	boidInit()

end

function _update()
	startTime=time()

	deltaTime=startTime-endTime

	-- deltaTime+=time()-deltaTime	--	resets makes it accurate (do it even matter)

	boidUpdate(deltaTime)

	endTime=time()
end

function _draw()
	cls()

	boidDraw()
end

